PORT=4000
MONGODB_URI=mongodb://localhost:27017/boardwright
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
WEB_ORIGIN=http://localhost:3000
# Free tier at resend.com — leave unset for local dev and password-reset
# emails just print to the server console instead of actually sending.
RESEND_API_KEY=re_your_actual_api_key
# Must be on a domain verified in your Resend account once you have one;
# the default below is Resend's own shared sandbox sender, which works
# immediately with no setup but isn't meant for real users long-term.
EMAIL_FROM=Boardwright <onboarding@resend.dev>
AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key
AWS_REGION=aws_region
NODE_ENV=development
