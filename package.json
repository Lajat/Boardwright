{
  "name": "boardwright",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time collaborative Kanban board — Next.js + Node/Express + MongoDB + Socket.io",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @boardwright/api dev",
    "dev:web": "pnpm --filter @boardwright/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
